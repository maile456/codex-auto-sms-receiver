# 只监听本机；不要将凭证控制台直接暴露到公网。
WEBUI_HOST=127.0.0.1
WEBUI_PORT=5015

# 只调用原项目的 Codex OAuth 入口，不调用注册入口。
CODEX_OAUTH_DRIVER=protocol

# 日志默认保留 30 天，并限制最多 1000 个文件 / 200 MB。
LOG_RETENTION_DAYS=30
LOG_MAX_FILES=1000
LOG_MAX_TOTAL_MB=200
CODEX_AUTH_URL_SOURCE=local

# Outlook 默认直连 Microsoft Graph，避免把 refreshToken 交给第三方取件服务。
OUTLOOK_FETCH_MODE=direct
OTP_MAX_WAIT=30
OTP_POLL_INTERVAL=5
# 通用取码 URL 通常到信较慢，单独使用更长等待和更密轮询。
GENERIC_API_OTP_MAX_WAIT=90
GENERIC_API_OTP_POLL_INTERVAL=3
GENERIC_API_OTP_ATTEMPTS=2

# 单个账号每次执行的硬超时（120-3600 秒）；超时会终止对应 Worker 并释放并发槽位。
CODEX_JOB_TIMEOUT_SECONDS=600
# 流水线并发上限（1-20）；默认 10，界面会读取并显示该上限。
CODEX_PIPELINE_MAX_CONCURRENCY=10

# 留空表示直连；多代理可按原项目格式填写。
PROXY_POOL=

# Codex 协议驱动需要手机验证时只使用 Hero SMS。
SMS_PROVIDER=hero
HERO_SMS_API_KEY=
SMS_COUNTRY=33
SMS_SERVICE=dr
SMS_MAX_RETRIES=10
SMS_CODE_WAIT=30

# Hero SMS：最多 10 个数字国家 ID，按逗号顺序生效。
HERO_SMS_COUNTRIES=33
HERO_SMS_MIN_PRICE=
HERO_SMS_MAX_PRICE=0.11
HERO_SMS_PREFERRED_PRICE=
# country / price / price_high
HERO_SMS_ACQUIRE_PRIORITY=country
HERO_SMS_REUSE_ENABLED=false

# 使用 CPA 授权地址时配置；本地 PKCE 模式无需填写。
CPA_MANAGEMENT_URL=
CPA_MANAGEMENT_KEY=
